# SuckerPot configuration template.
# Copy this file to .env and replace every placeholder with your own value.
# Never commit .env. Placeholders such as "change-me" must be replaced.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

# Prefix for container, network and volume names.
COMPOSE_PROJECT_NAME=suckerpot

# Port for the dashboard (published on the host).
# Must never be 22, 23, 80, 443, 3389 or the host's admin SSH port.
DASHBOARD_PORT=8443

# Optional: the port of this host's own admin SSH daemon. Only used by
# scripts/check-ports.sh to make sure no published port collides with it.
ADMIN_SSH_PORT=

# ---------------------------------------------------------------------------
# Host port mappings for the sensors
# ---------------------------------------------------------------------------

# Host port that the SSH sensor listens on (IPv4 only).
SSH_HOST_PORT=22

# Host port that the Telnet sensor listens on.
TELNET_HOST_PORT=23

# Host port that the web sensor listens on.
HTTP_HOST_PORT=80

# Host port that the web sensor's TLS listener uses (IPv4 only).
HTTPS_HOST_PORT=443

# Host port that the RDP sensor listens on.
RDP_HOST_PORT=3389

# Host port that the Redis sensor listens on (IPv4 only).
REDIS_HOST_PORT=6379

# Host port that the Docker API sensor listens on (IPv4 only).
DOCKER_HOST_PORT=2375

# Host port that the MySQL sensor listens on (IPv4 only).
MYSQL_HOST_PORT=3306

# Host port that the MSSQL sensor listens on (IPv4 only).
MSSQL_HOST_PORT=1433

# Host port that the ADB sensor listens on (IPv4 only).
ADB_HOST_PORT=5555

# Host port that the SMB (container port 4450) sensor listens on (IPv4 only).
SMB_HOST_PORT=445

# Host port that the SIP (both UDP and TCP) sensor listens on (IPv4 only).
SIP_HOST_PORT=5060

# ---------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB)
# ---------------------------------------------------------------------------

# Name of the database.
POSTGRES_DB=suckerpot

# Database user.
POSTGRES_USER=suckerpot

# Database password. Use a long random value.
POSTGRES_PASSWORD=change-me
# The two accounts below are used by the services at run time. They are created
# by the migration with minimal privileges. The owner account above is only used
# by the database container and by migrations.

# Role used by ingest (insert and update events and sessions).
POSTGRES_INGEST_USER=suckerpot_ingest
POSTGRES_INGEST_PASSWORD=change-me

# Role used by the API (read-only).
POSTGRES_API_USER=suckerpot_api
POSTGRES_API_PASSWORD=change-me

# Serve the OpenAPI schema and interactive docs (/docs, /redoc, /openapi.json).
# Keep false unless you are developing.
API_ENABLE_DOCS=false
# Extra browser origins allowed on the live WebSocket, comma-separated full URLs.
# Required behind a TLS-terminating reverse tunnel, e.g. https://dash.example.com
API_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Password for the Redis "admin" user (full access, for operators only).
# Not used by ingest or the API. At least 24 characters, different from the other Redis secrets.
# Generate one with: openssl rand -base64 32
REDIS_PASSWORD=change-me

# Password for the SSH sensor's ACL user. It can only XADD to the "events:ssh" stream.
REDIS_SENSOR_SSH_PASSWORD=change-me

# Password for the RDP sensor's ACL user. It can only XADD to the "events:rdp" stream.
REDIS_SENSOR_RDP_PASSWORD=change-me

# Password for the Telnet sensor's ACL user. It can only XADD to the "events:telnet" stream.
REDIS_SENSOR_TELNET_PASSWORD=change-me

# Password for the web sensor's ACL user. It can only XADD to the "events:web" stream.
REDIS_SENSOR_WEB_PASSWORD=change-me

# Password for the Redis sensor's ACL user. It can only XADD to the "events:redis" stream.
REDIS_SENSOR_REDIS_PASSWORD=change-me

# Password for the Docker API sensor's ACL user. It can only XADD to the "events:docker" stream.
REDIS_SENSOR_DOCKER_PASSWORD=change-me

# Password for the MySQL sensor's ACL user. It can only XADD to the "events:mysql" stream.
REDIS_SENSOR_MYSQL_PASSWORD=change-me

# Password for the MSSQL sensor's ACL user. It can only XADD to the "events:mssql" stream.
REDIS_SENSOR_MSSQL_PASSWORD=change-me

# Password for the ADB sensor's ACL user. It can only XADD to the "events:adb" stream.
REDIS_SENSOR_ADB_PASSWORD=change-me

# Password for the SMB sensor's ACL user. It can only XADD to the "events:smb" stream.
REDIS_SENSOR_SMB_PASSWORD=change-me

# Password for the SIP sensor's ACL user. It can only XADD to the "events:sip" stream.
REDIS_SENSOR_SIP_PASSWORD=change-me

# Password for the demo generator's ACL user. It can only XADD to the "events:*" streams.
REDIS_DEMO_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Dashboard authentication
# ---------------------------------------------------------------------------

# Username of the single admin account.
ADMIN_USERNAME=admin

# Argon2 hash of the admin password. REQUIRED: compose refuses to start without it.
# Generate it with: docker compose run --rm api python -m api.hashpw
# and paste it between single quotes (the hash contains "$" characters), e.g.
# ADMIN_PASSWORD_HASH='$argon2id$v=19$...'
ADMIN_PASSWORD_HASH=

# Secret used to sign session cookies. REQUIRED, at least 32 random characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me

# Hours a login stays valid.
SESSION_TTL_HOURS=12

# Send the session cookie only over HTTPS. Keep true when the dashboard is
# behind a TLS-terminating tunnel or proxy. Set false only for plain-HTTP local use.
COOKIE_SECURE=true

# Failed logins allowed per minute from one address, and in total.
LOGIN_RATE=5
LOGIN_RATE_GLOBAL=30

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header is trusted
# to find the client address (for example the address of your tunnel host).
# Empty = never trust those headers.
AUTH_TRUSTED_PROXIES=

# Comma-separated Host names the API answers to (for example dash.example.com).
# Empty = any host.
API_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Live globe
# ---------------------------------------------------------------------------

# Where the attack arcs land on the live globe. Use the centre of your COUNTRY
# (or region), never your real location: these values are sent to every dashboard
# user. Leave empty for the defaults (46.8, 8.2, "Switzerland").
SITE_HOME_LAT=
SITE_HOME_LON=
SITE_HOME_LABEL=

# ---------------------------------------------------------------------------
# Enrichment: GeoIP (optional)
# ---------------------------------------------------------------------------

# GeoIP database to use: auto, maxmind, dbip or off.
# auto = MaxMind GeoLite2 when an account is configured, otherwise the free
# DB-IP Lite databases (downloaded by ingest, no account needed).
GEOIP_PROVIDER=auto

# Days between database refreshes.
GEOIP_REFRESH_DAYS=30

# Give private and documentation addresses a fake location. Only for the demo
# and CI, where all addresses are synthetic. Keep false in production.
GEOIP_FAKE_FOR_PRIVATE=false

# Key that encrypts the enrichment API keys you enter on the Settings page
# (AES-256-GCM; stored in the database, never shown again). Optional: leave it
# empty and the Settings page cannot edit keys, while the keys below still work.
# Generate one with: openssl rand -base64 32
# Losing or changing it makes the saved keys unreadable: enter them again.
SETTINGS_ENCRYPTION_KEY=

# MaxMind account ID for GeoLite2 downloads. Optional.
# Without it (and with GEOIP_PROVIDER=auto), DB-IP Lite is used instead.
MAXMIND_ACCOUNT_ID=

# MaxMind licence key for GeoLite2 downloads. Optional.
MAXMIND_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Enrichment: reputation (optional)
# ---------------------------------------------------------------------------

# AbuseIPDB API key. Optional.
ABUSEIPDB_API_KEY=

# Maximum AbuseIPDB checks per day. The free tier allows 1000.
ABUSEIPDB_DAILY_QUOTA=1000

# GreyNoise Community API key. Optional.
GREYNOISE_API_KEY=

# Maximum GreyNoise checks per day. The free tier allows about 50.
GREYNOISE_DAILY_QUOTA=50

# CVE watch: once a day, ingest mirrors the CISA KEV catalogue, recent NVD CVEs and GitHub
# security advisories (public data) into the database. Set to false to turn it off.
CVE_WATCH_ENABLED=true

# NVD API key. Optional: without it the NVD allows 5 requests per 30 s, with it 50.
NVD_API_KEY=

# Token for the public GitHub advisories API. Optional: without it GitHub allows 60 requests
# per hour. Use a fine-grained token limited to public repositories, read-only, with no
# permissions at all. Never put your push or personal token here.
GITHUB_ADVISORY_TOKEN=

# Maximum requests per day to the NVD and to GitHub advisories (enforced, persisted).
CVE_NVD_DAILY_QUOTA=200
CVE_GITHUB_DAILY_QUOTA=100

# An IP is checked for reputation once it has produced this many events.
REPUTATION_MIN_EVENTS=10

# Seconds between two reputation check rounds.
REPUTATION_INTERVAL_S=30

# ---------------------------------------------------------------------------
# Indicators and threat intelligence (optional)
# ---------------------------------------------------------------------------
# Ingest extracts URLs, hosts and file hashes from recorded events and, when a key is set,
# asks public intel services whether they are known. This is passive: indicator hosts are never
# contacted, only the indicator value is sent to the fixed API hosts of abuse.ch and VirusTotal.

# Extract indicators from events (true/false).
INDICATORS_ENABLED=true

# abuse.ch Auth-Key (free, https://auth.abuse.ch/) for URLhaus and ThreatFox. Optional.
ABUSECH_AUTH_KEY=

# Maximum abuse.ch requests per day (URLhaus and ThreatFox share it).
ABUSECH_DAILY_QUOTA=1000

# VirusTotal API key. Optional. Used for file hashes only.
VIRUSTOTAL_API_KEY=

# Maximum VirusTotal requests per day. The free tier allows 500.
VIRUSTOTAL_DAILY_QUOTA=400

# Seconds between two threat-intel rounds.
INTEL_INTERVAL_S=30

# Comma-separated host names and addresses to never record as indicators: your own domains and
# public IP. A name also covers its subdomains.
INDICATORS_IGNORE=

# Keep documentation addresses and example domains as indicators. Only for the demo data
# (just demo); leave it false on a real sensor.
INDICATORS_KEEP_DOCUMENTATION=false

# Most sessions linked to one indicator. Counters stay exact beyond it.
INDICATORS_LINK_CAP=500

# ---------------------------------------------------------------------------
# Payloads (off by default)
# ---------------------------------------------------------------------------

# If true, ingest fetches files from captured download URLs.
# Fetched files go to quarantine and are never executed. Keep this false
# unless you understand the risk.
FETCH_PAYLOADS=false

# Maximum size of one fetched payload, in bytes (10 MiB here).
PAYLOAD_MAX_BYTES=10485760

# Timeout for one payload fetch, in seconds.
PAYLOAD_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

# Days to keep raw events (7 to 3650). Aggregates are kept forever.
# Applied by the migrate service on every start; see docs/retention.md.
RETENTION_DAYS=90
# Hard ceiling for the database size in GB. Above 90% the oldest raw events are
# dropped (aggregates are kept); above 95% ingest stores only previews of large events.
DB_MAX_SIZE_GB=10

# ---------------------------------------------------------------------------
# Fake service identity
# ---------------------------------------------------------------------------

# Hostname that the fake SSH service shows to clients.
SSH_HOSTNAME=srv-web01

# SSH banner that the fake SSH service sends to clients.
SSH_BANNER="SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13.14"

# Comma-separated user:password pairs that the fake SSH server accepts.
# Keep them weak on purpose: attackers must be able to "log in" to be observed.
SSH_ACCEPT_CREDENTIALS=root:root,root:123456,root:password,admin:admin,ubuntu:ubuntu,pi:raspberry,user:user

# Probability (0.0 to 1.0) of accepting any non-empty password.
SSH_ACCEPT_RANDOM_PROB=0.0

# Failed attempts allowed per connection before it is closed.
SSH_MAX_AUTH_ATTEMPTS=6

# Maximum simultaneous SSH connections, in total and per source IP.
SSH_MAX_CONNECTIONS=200
SSH_MAX_PER_IP=5

# Optional: fixed NetBIOS name (1 to 15 characters) shown by the RDP sensor's certificate.
# By default a realistic name is derived and kept in the rdp-data volume.
# RDP_HOSTNAME=

# Publisher backstop for every sensor: maximum serialized event bytes per second
# and burst. Protects Redis and ingest from a single flooding source.
# EVENTS_MAX_BYTES_PER_SEC=200000
# EVENTS_MAX_BYTES_BURST=2000000

# ---------------------------------------------------------------------------
# SSH sensor tuning (optional). Defaults shown; uncomment to change.
# ---------------------------------------------------------------------------

# Largest SSH channel window, in KiB (limits data buffered per channel).
# SSH_CHANNEL_WINDOW_KB=32

# Inbound traffic caps, in KiB per second: per connection and for the whole sensor.
# SSH_INBOUND_CONN_KB_PER_SEC=32
# SSH_INBOUND_KB_PER_SEC=256

# Fake-shell CPU budget: share of one CPU all sessions may use, and burst (seconds).
# SSH_SHELL_CPU_SHARE=0.3
# SSH_SHELL_CPU_BURST=0.2

# Memory protection. The limit is set to the container's mem_limit in compose
# (SSH_MEMORY_LIMIT_MB=256 there). The sensor sheds load at "pressure" and
# refuses new work at "critical" (fractions of the limit); one source IP may hold
# at most "share per ip" of the budget.
# SSH_MEMORY_PRESSURE=0.70
# SSH_MEMORY_CRITICAL=0.85
# SSH_MEMORY_SHARE_PER_IP=0.25
# SSH_MEMORY_BUDGET_MB=48

# Event size caps (bytes per second and burst), per source IP and for the sensor.
# SSH_IP_EVENT_BYTES_PER_SEC=20000
# SSH_IP_EVENT_BYTES_BURST=1000000
# SSH_GLOBAL_EVENT_BYTES_PER_SEC=200000
# SSH_GLOBAL_EVENT_BYTES_BURST=2000000

# Seconds between the sensor's statistics log line and its per-IP summary events.
# SSH_STATS_INTERVAL=60
# SSH_SUMMARY_INTERVAL=60

# ---------------------------------------------------------------------------
# Web sensor tuning (optional). Defaults shown; uncomment to change.
# ---------------------------------------------------------------------------

# Host name shown in the certificate and in phpinfo.
# WEB_HOSTNAME=srv-web01

# Fake software versions. PHP must be 8.3.N with N below 36 (an unpatched version).
# WEB_PHP_VERSION=8.3.6
# WEB_WP_VERSION=6.8.1

# Connection caps: in total and per source IP.
# WEB_MAX_CONNECTIONS=200
# WEB_MAX_PER_IP=10

# Streams that ingest reads, comma-separated. Add one per sensor.
INGEST_STREAMS=events:ssh,events:telnet,events:web,events:rdp,events:redis,events:docker,events:mysql,events:mssql,events:adb,events:smb,events:sip

# ---------------------------------------------------------------------------
# M1 additions: ingest, dashboard bind address and demo data
# ---------------------------------------------------------------------------

# Password for the health ACL user. It can only run PING (used by the Redis healthcheck).
REDIS_HEALTH_PASSWORD=change-me

# Password for the ingest ACL user. Allowed to read and acknowledge the events
# stream only. Use a long random value.
REDIS_INGEST_PASSWORD=change-me

# Address the dashboard port is bound to on the host. 127.0.0.1 keeps it local.
# Set it to the host's LAN address only when a reverse tunnel on another machine
# must reach it. The port must then be filtered upstream (hypervisor or router
# firewall, or the DOCKER-USER chain), because published Docker ports bypass
# ordinary host INPUT rules.
DASHBOARD_BIND=127.0.0.1

# Safety switch: Redis and migrations refuse secrets that are shorter than 24
# characters or reused between accounts. Set this to 1 ONLY in CI or throwaway tests.
# SUCKERPOT_ALLOW_DEFAULT_SECRETS=0

# Approximate maximum length of the Redis events stream (XADD MAXLEN ~).
EVENTS_MAXLEN=10000

# Demo data generator (just demo): how many days to cover, how many sessions
# to create, and the random seed (same seed, same data).
DEMO_DAYS=30
DEMO_SESSIONS=3000
DEMO_SEED=42

# Stream length cap used by the demo generator only. Keep it above the number of
# events per sensor in a backfill, or entries ingest has not read yet get trimmed.
DEMO_EVENTS_MAXLEN=100000

# ---------------------------------------------------------------------------
# Database, service and VoIP sensors (optional). Defaults shown; uncomment to change.
# ---------------------------------------------------------------------------

# Stream length cap (XADD MAXLEN ~) for the Redis, Docker, MySQL, MSSQL, ADB, SMB and SIP
# sensors. Kept short so a burst on seven more streams cannot fill Redis memory; ingest
# drains the streams continuously, and a sensor drops (never buffers) events when XADD fails.
# EVENTS_MAXLEN_LOW=3000

# Connection caps per sensor: in total and per source IP.
# REDIS_MAX_CONNECTIONS=200
# REDIS_MAX_PER_IP=8
# DOCKER_MAX_CONNECTIONS=200
# DOCKER_MAX_PER_IP=8
# MYSQL_MAX_CONNECTIONS=200
# MYSQL_MAX_PER_IP=8
# MSSQL_MAX_CONNECTIONS=200
# MSSQL_MAX_PER_IP=8

# RDP: "required" (default) only accepts NLA clients and records NTLM logins; "optional" also
# accepts TLS-only clients and records the cleartext password they send in the Client Info PDU.
# RDP_NLA_MODE=required
# Decoy accounts whose NTLM responses are checked (user:password, comma separated). Only these
# pairs are ever verified; nothing else is cracked.
# RDP_ACCOUNTS=administrator:P@ssw0rd,administrator:123456,admin:admin

# ADB_MAX_CONNECTIONS=200
# ADB_MAX_PER_IP=8
# SMB_MAX_CONNECTIONS=200
# SMB_MAX_PER_IP=10
# SIP_MAX_CONNECTIONS=200
# SIP_MAX_PER_IP=8

# MySQL sensor: accounts that "work", as user:password pairs (empty password after the colon).
# MYSQL_ACCOUNTS=root:,root:root,admin:admin,mysql:mysql

# SMB sensor: optional NetBIOS host name (1 to 15 characters) and domain. By default
# realistic names are derived and kept in the smb-sensor-data volume.
# SMB_HOSTNAME=
# SMB_DOMAIN=
# How to treat an SMBv1 negotiation: "steer" (default, answer with SMB2) or "reset".
# SMB_SMB1_MODE=steer

# SIP sensor: public IP addresses of this honeypot, comma-separated. The sensor never
# answers them, so it cannot be turned into a reflector aimed at itself. Leave empty
# if unknown; replies are rate limited and never larger than the request anyway.
# SIP_OWN_IPS=
