# SuckerPot configuration template.
# Copy this file to .env and replace every placeholder with your own value.
# Never commit .env. Placeholders such as "change-me" must be replaced.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

# Prefix for container, network and volume names.
COMPOSE_PROJECT_NAME=suckerpot

# Port for the dashboard (published on the host).
# Must never be 22, 23, 80, 443, 3389 or the host's admin SSH port.
DASHBOARD_PORT=8443

# ---------------------------------------------------------------------------
# Host port mappings for the sensors
# ---------------------------------------------------------------------------

# Host port that the SSH sensor listens on.
SSH_HOST_PORT=22

# Host port that the Telnet sensor listens on.
TELNET_HOST_PORT=23

# Host port that the web sensor listens on.
HTTP_HOST_PORT=80

# Host port that the RDP sensor listens on.
RDP_HOST_PORT=3389

# ---------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB)
# ---------------------------------------------------------------------------

# Name of the database.
POSTGRES_DB=suckerpot

# Database user.
POSTGRES_USER=suckerpot

# Database password. Use a long random value.
POSTGRES_PASSWORD=change-me
# The two accounts below are used by the services at run time. They are created
# by the migration with minimal privileges. The owner account above is only used
# by the database container and by migrations.

# Role used by ingest (insert and update events and sessions).
POSTGRES_INGEST_USER=suckerpot_ingest
POSTGRES_INGEST_PASSWORD=change-me

# Role used by the API (read-only).
POSTGRES_API_USER=suckerpot_api
POSTGRES_API_PASSWORD=change-me

# Serve the OpenAPI schema and interactive docs (/docs, /redoc, /openapi.json).
# Keep false unless you are developing.
API_ENABLE_DOCS=false

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Password for the Redis "admin" user (full access, for operators only).
# Not used by ingest or the API. At least 24 characters, different from the other Redis secrets.
# Generate one with: openssl rand -base64 32
REDIS_PASSWORD=change-me

# Password for the sensor ACL user. Allowed to XADD to the events stream only.
REDIS_SENSOR_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Dashboard authentication
# ---------------------------------------------------------------------------

# Username of the single admin account.
ADMIN_USERNAME=admin

# Argon2 hash of the admin password. Leave empty until you generate one.
# The generation command is documented in a later release.
ADMIN_PASSWORD_HASH=

# Secret used to sign session cookies. Use a long random value.
SESSION_SECRET=change-me

# ---------------------------------------------------------------------------
# Enrichment: GeoIP (optional)
# ---------------------------------------------------------------------------

# MaxMind account ID for GeoLite2 downloads. Optional.
# Without it, GeoIP fields stay empty.
MAXMIND_ACCOUNT_ID=

# MaxMind licence key for GeoLite2 downloads. Optional.
MAXMIND_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Enrichment: reputation (optional)
# ---------------------------------------------------------------------------

# AbuseIPDB API key. Optional.
ABUSEIPDB_API_KEY=

# Maximum AbuseIPDB checks per day. The free tier allows 1000.
ABUSEIPDB_DAILY_QUOTA=1000

# GreyNoise Community API key. Optional.
GREYNOISE_API_KEY=

# Maximum GreyNoise checks per day. The free tier allows about 50.
GREYNOISE_DAILY_QUOTA=50

# ---------------------------------------------------------------------------
# Payloads (off by default)
# ---------------------------------------------------------------------------

# If true, ingest fetches files from captured download URLs.
# Fetched files go to quarantine and are never executed. Keep this false
# unless you understand the risk.
FETCH_PAYLOADS=false

# Maximum size of one fetched payload, in bytes (10 MiB here).
PAYLOAD_MAX_BYTES=10485760

# Timeout for one payload fetch, in seconds.
PAYLOAD_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

# Days to keep raw events. Aggregates are kept forever.
RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Fake service identity
# ---------------------------------------------------------------------------

# Hostname that the fake SSH service shows to clients.
SSH_HOSTNAME=srv-web01

# SSH banner that the fake SSH service sends to clients.
SSH_BANNER="SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13.5"

# ---------------------------------------------------------------------------
# M1 additions: ingest, dashboard bind address and demo data
# ---------------------------------------------------------------------------

# Password for the health ACL user. It can only run PING (used by the Redis healthcheck).
REDIS_HEALTH_PASSWORD=change-me

# Password for the ingest ACL user. Allowed to read and acknowledge the events
# stream only. Use a long random value.
REDIS_INGEST_PASSWORD=change-me

# Address the dashboard port is bound to on the host. 127.0.0.1 keeps it local.
# Set it to the host's LAN address only when a reverse tunnel on another machine
# must reach it. The port must then be filtered upstream (hypervisor or router
# firewall, or the DOCKER-USER chain), because published Docker ports bypass
# ordinary host INPUT rules.
DASHBOARD_BIND=127.0.0.1

# Safety switch: Redis and migrations refuse secrets that are shorter than 24
# characters or reused between accounts. Set this to 1 ONLY in CI or throwaway tests.
# SUCKERPOT_ALLOW_DEFAULT_SECRETS=0

# Approximate maximum length of the Redis events stream (XADD MAXLEN ~).
EVENTS_MAXLEN=10000

# Demo data generator (just demo): how many days to cover, how many sessions
# to create, and the random seed (same seed, same data).
DEMO_DAYS=30
DEMO_SESSIONS=3000
DEMO_SEED=42
