# SuckerPot configuration template.
# Copy this file to .env and replace every placeholder with your own value.
# Never commit .env. Placeholders such as "change-me" must be replaced.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

# Prefix for container, network and (external) data volume names. REQUIRED: compose and the
# live just recipes refuse to run without it.
# THE LIVE INSTALL ONLY: uncomment it (set it to suckerpot) in the live .env. It stays commented
# here so a .env copied from this file for a test never carries the live name. Tests set their
# own throwaway name (just test-integration, just up-test and CI do this themselves).
# COMPOSE_PROJECT_NAME=suckerpot

# Name prefix of the external data volumes: the live ones are suckerpot_db-data, suckerpot_backups, ...
# REQUIRED by docker-compose.yml, so a checkout without .env cannot start (or delete) anything.
# THE LIVE INSTALL ONLY: set it to suckerpot in the live .env (placeholder below on purpose, so a
# .env copied from this file for a test can never reach the live volumes). Test stacks set their
# own value. Allowed: lowercase letters, digits, - and _ (max 41 characters).
# SUCKERPOT_VOLUME_PREFIX=<live-prefix>

# Number of daily database dumps to keep in the backups volume.
# BACKUP_KEEP=7

# ---------------------------------------------------------------------------
# Install mode, version and optional features (written by scripts/install.sh)
# ---------------------------------------------------------------------------

# "images" pulls the signed release images, "source" builds them from this checkout.
SUCKERPOT_INSTALL_MODE=source

# Registry prefix and release tag of the images. Only the installer sets these, in "images"
# mode. When unset, images are built locally and named local/<project>-<service>, so a test
# stack can never retag the images of another project.
# SUCKERPOT_IMAGE_PREFIX=ghcr.io/selfhostr/suckerpot
# SUCKERPOT_VERSION=v0.0.0

# Version and commit baked into locally built images (shown in Settings). Set by the update
# recipes; leave them unset for a plain build ("dev").
# SUCKERPOT_BUILD_VERSION=dev
# SUCKERPOT_BUILD_COMMIT=unknown

# Turn a sensor off with 0 (no container, no host port). 1 = on. Also used by the setup
# checklist to know which ports to forward.
SENSOR_SSH=1
SENSOR_TELNET=1
SENSOR_WEB=1
SENSOR_RDP=1
SENSOR_REDIS=1
SENSOR_DOCKER=1
SENSOR_MYSQL=1
SENSOR_MSSQL=1
SENSOR_ADB=1
SENSOR_SMB=1
SENSOR_SIP=1
SENSOR_SYNOLOGY=1

# Daily check for a newer release: one anonymous request to GitHub through the VPN egress
# proxy (nothing is sent while the VPN is not up). It never installs anything by itself.
UPDATE_CHECK_ENABLED=false
UPDATE_CHECK_REPO=selfhostr/suckerpot

# Low-memory machines (2 GiB): the installer sets this to
# docker-compose.yml:docker-compose.lowmem.yml with --lowmem on. Leave it unset otherwise.
# COMPOSE_FILE=docker-compose.yml:docker-compose.lowmem.yml

# Memory ceiling of Redis in MiB (32 to 4096). The low-memory overlay lowers it to 96.
# REDIS_MAXMEMORY_MB=192

# RDP sensor connection caps (total, per source IP, TLS handshakes per source IP).
# RDP_MAX_CONNECTIONS=200
# RDP_MAX_PER_IP=8
# RDP_MAX_TLS_PER_IP=4

# Port for the dashboard (published on the host).
# Must never be 22, 23, 80, 443, 3389 or the host's admin SSH port.
DASHBOARD_PORT=8443

# Optional: the port of this host's own admin SSH daemon. Only used by
# scripts/check-ports.sh to make sure no published port collides with it.
ADMIN_SSH_PORT=

# ---------------------------------------------------------------------------
# Host port mappings for the sensors
# ---------------------------------------------------------------------------

# Host port that the SSH sensor listens on (IPv4 only).
SSH_HOST_PORT=22

# Host port that the Telnet sensor listens on.
TELNET_HOST_PORT=23

# Host port that the web sensor listens on.
HTTP_HOST_PORT=80

# Host port that the web sensor's TLS listener uses (IPv4 only).
HTTPS_HOST_PORT=443

# Host port that the RDP sensor listens on.
RDP_HOST_PORT=3389

# Host port that the Redis sensor listens on (IPv4 only).
REDIS_HOST_PORT=6379

# Host port that the Docker API sensor listens on (IPv4 only).
DOCKER_HOST_PORT=2375

# Host port that the MySQL sensor listens on (IPv4 only).
MYSQL_HOST_PORT=3306

# Host port that the MSSQL sensor listens on (IPv4 only).
MSSQL_HOST_PORT=1433

# Host port that the ADB sensor listens on (IPv4 only).
ADB_HOST_PORT=5555

# Host port that the SMB (container port 4450) sensor listens on (IPv4 only).
SMB_HOST_PORT=445

# Host port that the SIP (both UDP and TCP) sensor listens on (IPv4 only).
SIP_HOST_PORT=5060

# Host ports that the Synology DSM sensor listens on, HTTP and HTTPS (IPv4 only). Never use
# them for the dashboard.
SYNOLOGY_HTTP_HOST_PORT=5000
SYNOLOGY_HTTPS_HOST_PORT=5001

# ---------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB)
# ---------------------------------------------------------------------------

# Name of the database.
POSTGRES_DB=suckerpot

# Database user.
POSTGRES_USER=suckerpot

# Database password. Use a long random value.
POSTGRES_PASSWORD=change-me
# The two accounts below are used by the services at run time. They are created
# by the migration with minimal privileges. The owner account above is only used
# by the database container and by migrations.

# Role used by ingest (insert and update events and sessions).
POSTGRES_INGEST_USER=suckerpot_ingest
POSTGRES_INGEST_PASSWORD=change-me

# Role used by the API (read-only).
POSTGRES_API_USER=suckerpot_api
POSTGRES_API_PASSWORD=change-me

# Serve the OpenAPI schema and interactive docs (/docs, /redoc, /openapi.json).
# Keep false unless you are developing.
API_ENABLE_DOCS=false
# Extra browser origins allowed on the live WebSocket, comma-separated full URLs.
# Required behind a TLS-terminating reverse tunnel, e.g. https://dash.example.com
API_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Password for the Redis "admin" user (full access, for operators only).
# Not used by ingest or the API. At least 24 characters, different from the other Redis secrets.
# Generate one with: openssl rand -base64 32
REDIS_PASSWORD=change-me

# Password for the SSH sensor's ACL user. It can only XADD to the "events:ssh" stream.
REDIS_SENSOR_SSH_PASSWORD=change-me

# Password for the RDP sensor's ACL user. It can only XADD to the "events:rdp" stream.
REDIS_SENSOR_RDP_PASSWORD=change-me

# Password for the Telnet sensor's ACL user. It can only XADD to the "events:telnet" stream.
REDIS_SENSOR_TELNET_PASSWORD=change-me

# Password for the web sensor's ACL user. It can only XADD to the "events:web" stream.
REDIS_SENSOR_WEB_PASSWORD=change-me

# Password for the Redis sensor's ACL user. It can only XADD to the "events:redis" stream.
REDIS_SENSOR_REDIS_PASSWORD=change-me

# Password for the Docker API sensor's ACL user. It can only XADD to the "events:docker" stream.
REDIS_SENSOR_DOCKER_PASSWORD=change-me

# Password for the MySQL sensor's ACL user. It can only XADD to the "events:mysql" stream.
REDIS_SENSOR_MYSQL_PASSWORD=change-me

# Password for the MSSQL sensor's ACL user. It can only XADD to the "events:mssql" stream.
REDIS_SENSOR_MSSQL_PASSWORD=change-me

# Password for the ADB sensor's ACL user. It can only XADD to the "events:adb" stream.
REDIS_SENSOR_ADB_PASSWORD=change-me

# Password for the SMB sensor's ACL user. It can only XADD to the "events:smb" stream.
REDIS_SENSOR_SMB_PASSWORD=change-me

# Password for the SIP sensor's ACL user. It can only XADD to the "events:sip" stream.
REDIS_SENSOR_SIP_PASSWORD=change-me

# Password for the Synology sensor's ACL user. It can only XADD to the "events:synology" stream.
REDIS_SENSOR_SYNOLOGY_PASSWORD=change-me

# Password for the demo generator's ACL user. It can only XADD to the "events:*" streams.
REDIS_DEMO_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Dashboard authentication
# ---------------------------------------------------------------------------

# Username of the owner account. It is always an administrator and works even when the
# database is down. Other people get their own accounts from Settings > Users.
ADMIN_USERNAME=admin

# Argon2 hash of the admin password. REQUIRED: compose refuses to start without it.
# Generate it with: docker compose run --rm api python -m api.hashpw
# and paste it between single quotes (the hash contains "$" characters), e.g.
# ADMIN_PASSWORD_HASH='$argon2id$v=19$...'
ADMIN_PASSWORD_HASH=

# Secret used to sign session cookies. REQUIRED, at least 32 random characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me

# Hours a login stays valid.
SESSION_TTL_HOURS=12

# Send the session cookie only over HTTPS. Keep true when the dashboard is
# behind a TLS-terminating tunnel or proxy. Set false only for plain-HTTP local use.
COOKIE_SECURE=true

# Failed logins allowed per minute from one address, and in total.
LOGIN_RATE=5
LOGIN_RATE_GLOBAL=30

# Failed logins allowed per minute for one username, from any address.
LOGIN_RATE_USER=10

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header is trusted
# to find the client address (for example the address of your tunnel host).
# Empty = never trust those headers.
AUTH_TRUSTED_PROXIES=

# Comma-separated Host names the API answers to (for example dash.example.com).
# Empty = any host.
API_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Live globe
# ---------------------------------------------------------------------------

# Where the attack arcs land on the live globe. Use the centre of your COUNTRY
# (or region), never your real location: these values are sent to every dashboard
# user. Leave empty for the defaults (46.8, 8.2, "Switzerland").
SITE_HOME_LAT=
SITE_HOME_LON=
SITE_HOME_LABEL=

# ---------------------------------------------------------------------------
# Enrichment: GeoIP (optional)
# ---------------------------------------------------------------------------

# GeoIP database to use: auto, maxmind, dbip or off.
# auto = MaxMind GeoLite2 when an account is configured, otherwise the free
# DB-IP Lite databases (downloaded by ingest, no account needed).
GEOIP_PROVIDER=auto

# Days between database refreshes.
GEOIP_REFRESH_DAYS=30

# Give private and documentation addresses a fake location. Only for the demo
# and CI, where all addresses are synthetic. Keep false in production.
GEOIP_FAKE_FOR_PRIVATE=false

# Key that encrypts the enrichment API keys you enter on the Settings page
# (AES-256-GCM; stored in the database, never shown again). Optional: leave it
# empty and the Settings page cannot edit keys, while the keys below still work.
# Generate one with: openssl rand -base64 32
# Losing or changing it makes the saved keys unreadable: enter them again.
SETTINGS_ENCRYPTION_KEY=

# MaxMind account ID for GeoLite2 downloads. Optional.
# Without it (and with GEOIP_PROVIDER=auto), DB-IP Lite is used instead.
MAXMIND_ACCOUNT_ID=

# MaxMind licence key for GeoLite2 downloads. Optional.
MAXMIND_LICENSE_KEY=

# ---------------------------------------------------------------------------
# Enrichment: reputation (optional)
# ---------------------------------------------------------------------------

# AbuseIPDB API key. Optional.
ABUSEIPDB_API_KEY=

# Maximum AbuseIPDB checks per day. The free tier allows 1000.
ABUSEIPDB_DAILY_QUOTA=1000

# GreyNoise Community API key. Optional.
GREYNOISE_API_KEY=

# Maximum GreyNoise checks per day. The free tier allows about 50.
GREYNOISE_DAILY_QUOTA=50

# CVE watch: once a day, ingest mirrors the CISA KEV catalogue, recent NVD CVEs and GitHub
# security advisories (public data) into the database. Set to false to turn it off.
CVE_WATCH_ENABLED=true

# NVD API key. Optional: without it the NVD allows 5 requests per 30 s, with it 50.
NVD_API_KEY=

# Token for the public GitHub advisories API. Optional: without it GitHub allows 60 requests
# per hour. Use a fine-grained token limited to public repositories, read-only, with no
# permissions at all. Never put your push or personal token here.
GITHUB_ADVISORY_TOKEN=

# Maximum requests per day to the NVD and to GitHub advisories (enforced, persisted).
CVE_NVD_DAILY_QUOTA=200
CVE_GITHUB_DAILY_QUOTA=100

# An IP is checked for reputation once it has produced this many events.
REPUTATION_MIN_EVENTS=10

# Seconds between two reputation check rounds.
REPUTATION_INTERVAL_S=30

# ---------------------------------------------------------------------------
# Indicators and threat intelligence (optional)
# ---------------------------------------------------------------------------
# Ingest extracts URLs, hosts and file hashes from recorded events and, when a key is set,
# asks public intel services whether they are known. This is passive: indicator hosts are never
# contacted, only the indicator value is sent to the fixed API hosts of abuse.ch and VirusTotal.

# Extract indicators from events (true/false).
INDICATORS_ENABLED=true

# abuse.ch Auth-Key (free, https://auth.abuse.ch/) for URLhaus and ThreatFox. Optional.
ABUSECH_AUTH_KEY=

# Maximum abuse.ch requests per day (URLhaus and ThreatFox share it).
ABUSECH_DAILY_QUOTA=1000

# VirusTotal API key. Optional. Used for file hashes only.
VIRUSTOTAL_API_KEY=

# Maximum VirusTotal requests per day. The free tier allows 500.
VIRUSTOTAL_DAILY_QUOTA=400

# Seconds between two threat-intel rounds.
INTEL_INTERVAL_S=30

# Comma-separated host names, addresses and CIDR blocks (203.0.113.0/24) to never record as
# indicators: your own domains and PUBLIC IP. SET THIS before going live, or your own address
# can show up as attack infrastructure. A name also covers its subdomains. The hosts in
# API_ALLOWED_HOSTS and API_ALLOWED_ORIGINS are added automatically.
INDICATORS_IGNORE=

# Keep documentation addresses and example domains as indicators. Only for the demo data
# (just demo); leave it false on a real sensor.
INDICATORS_KEEP_DOCUMENTATION=false

# Most sessions linked to one indicator. Counters stay exact beyond it.
INDICATORS_LINK_CAP=500

# Most indicator rows kept. The hourly job drops the least sighted, oldest single-source ones
# first, and halves the ceiling while the database disk guard is trimming.
INDICATORS_MAX_ROWS=500000

# ---------------------------------------------------------------------------
# Anonymous egress and payload collection (M21)
# ---------------------------------------------------------------------------
# Every outbound request of the stack (GeoIP downloads, reputation and intel lookups, CVE
# feeds, LLM, alerts, payload fetching) goes through a WireGuard tunnel in the `vpn` service.
# Without it those features stay idle. There is no direct mode.
#
# Turn it on by listing the profile (needs a WireGuard config from a VPN provider):
# COMPOSE_PROFILES=egress

# WireGuard settings from your provider's config file. Placeholders only: never commit real ones.
# A .conf file uploaded from Settings > VPN overrides every VPN_WG_* value below (the vpn
# container restarts on it); "Use the .env settings again" in Settings removes the upload.
VPN_WG_PRIVATE_KEY=
VPN_WG_PEER_PUBLIC_KEY=
# Comma-separated interface addresses. IPv6 entries are ignored (the networks have no IPv6).
VPN_WG_ADDRESSES=
# The provider's DNS address (informational: names resolve through the tunnel).
VPN_WG_DNS=
# The server's address, split in two. Example: 203.0.113.10 and 51820.
VPN_WG_ENDPOINT_IP=
VPN_WG_ENDPOINT_PORT=

# Password of the vpn HTTP proxy, shared by ingest and collector (at least 24 characters).
EGRESS_PROXY_PASSWORD=
# Defaults shown; change only if you rename the service.
# EGRESS_PROXY_URL=http://vpn:8888
# EGRESS_CONTROL_URL=http://vpn:8000
# Addresses that answer with the caller's public IP. At least two must agree.
# EGRESS_ECHO_URLS=https://api.ipify.org,https://icanhazip.com
# Networks the VPN exit address must belong to (comma-separated CIDRs). Empty = the /24 of
# VPN_WG_ENDPOINT_IP. Set it if your provider exits elsewhere (Settings shows the result).
# EGRESS_ALLOWED_CIDRS=
# Seconds between egress self-checks.
# EGRESS_CHECK_INTERVAL_S=300
# Autonomous systems the VPN exit must never belong to (comma-separated AS numbers, for example
# your own ISP). The gate closes with "exit_asn_denied" and the dashboard will not offer to trust
# such an exit. Empty by default. Set it for both ingest and api.
# EGRESS_DENY_ASNS=

# Database passwords of the collector and analyzer roles (at least 24 characters, all different).
# Required when COMPOSE_PROFILES contains egress.
POSTGRES_COLLECTOR_PASSWORD=
POSTGRES_ANALYZER_PASSWORD=
# Role names (optional; defaults shown).
# POSTGRES_COLLECTOR_USER=suckerpot_collector
# POSTGRES_ANALYZER_USER=suckerpot_analyzer

# Collector: fetches files behind captured download URLs through the VPN, stores them in
# quarantine (never executed) and the analyzer inspects them statically. Off by default.
COLLECTOR_ENABLED=false
# COLLECTOR_POLL_S=15
# Largest file kept, in bytes (16 MiB).
# COLLECTOR_MAX_BYTES=16777216
# COLLECTOR_TIMEOUT_S=60
# COLLECTOR_CONNECT_TIMEOUT_S=10
# COLLECTOR_MAX_REDIRECTS=3
# COLLECTOR_CONCURRENCY=2
# Seconds between two requests to the same host.
# COLLECTOR_HOST_INTERVAL_S=10
# COLLECTOR_HOURLY_QUOTA=60
# COLLECTOR_DAILY_QUOTA=500
# COLLECTOR_REFETCH_HOURS=24
# Follow URLs found inside fetched scripts this many levels deep.
# COLLECTOR_MAX_DEPTH=2
# Extra CIDRs the collector must never contact (your own ranges), comma-separated.
# COLLECTOR_DENY_CIDRS=
# Quarantine size cap in MB, and days to keep a file after it was last seen.
# QUARANTINE_MAX_MB=2048
# QUARANTINE_RETENTION_DAYS=90
# Analyzer: wall-clock timeout and memory cap (MB) of the parser child process.
# ANALYZER_TIMEOUT_S=60
# ANALYZER_MEMORY_MB=384

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------

# Days to keep raw events (7 to 3650). Aggregates are kept forever.
# Applied by the migrate service on every start; see docs/retention.md.
RETENTION_DAYS=90
# Hard ceiling for the database size in GB. Above 90% the oldest raw events are
# dropped (aggregates are kept); above 95% ingest stores only previews of large events.
DB_MAX_SIZE_GB=10

# Row ceilings of the campaign and script tables (1000 to 50 million). The oldest, least
# sighted, single-source rows go first; halved while the disk guard is trimming.
# CAMPAIGNS_MAX_ROWS=50000
# SCRIPTS_MAX_ROWS=100000

# ---------------------------------------------------------------------------
# Campaigns, ATT&CK, blocklists, scripts, alerts and reports (M15 to M19)
# ---------------------------------------------------------------------------
# Every feature is off by default. Defaults shown; uncomment to change.

# MITRE ATT&CK catalogue sync, and campaign clustering of finished sessions.
# ATTACK_ENABLED=false
# CAMPAIGNS_ENABLED=false
# A campaign needs one clustering key seen from this many distinct sources (2 to 100).
# CAMPAIGN_MIN_SOURCES=2
# Sessions linked to one campaign (10 to 10000).
# CAMPAIGN_LINK_CAP=500

# Scored blocklists (ip, domain, url, hash) over the last N days, at most N rows.
# BLOCKLIST_ENABLED=false
# BLOCKLIST_WINDOW_DAYS=30
# BLOCKLIST_MAX_ROWS=20000
# Machine-readable feeds for firewalls (/feeds, bearer tokens created in Settings).
# FEEDS_ENABLED=false
# Addresses, networks and names that must never reach a blocklist (comma separated), on top of
# AUTH_TRUSTED_PROXIES, API_ALLOWED_HOSTS, INDICATORS_IGNORE, public resolvers and big SaaS/CDN
# domains. Put your own public IP, partners and tunnel hosts here.
# BLOCKLIST_NEVER=

# Script library, and the optional LLM explanation of scripts. The LLM sends the normalised
# command text (addresses and URLs are replaced by placeholders) to the Anthropic API; it needs a key, which can also be
# set in Settings.
# SCRIPTS_ENABLED=false
# LLM_ENABLED=false
# LLM_DAILY_QUOTA=50
# LLM_MONTHLY_TOKEN_CAP=2000000
# LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Alerts (Discord, Teams, e-mail) and the weekly report. The SMTP password can also be set in
# Settings.
# ALERTS_ENABLED=false
# REPORTS_ENABLED=false
# SMTP_PASSWORD=
# E-mail alerts need an SMTP server that supports TLS (the certificate is always checked).
# SMTP_SECURITY is starttls (usually port 587) or ssl (usually port 465); plain text is not offered.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=alerts@example.org
# SMTP_FROM=alerts@example.org
# SMTP_SECURITY=starttls
# Optional: the public https address of the dashboard. Alerts then link to the matching page.
# ALERTS_DASHBOARD_URL=https://dashboard.example.org
# Time zone that decides when "Monday morning" starts for the weekly report (IANA name).
# SITE_TIMEZONE=UTC

# Anonymous abuse reporting (M22). Off by default. The worker looks up the abuse contact of
# hostile networks (RDAP, only through the VPN egress, quota-limited) and prepares DRAFT reports in
# the dashboard. Nothing is ever sent: you read each draft and send it yourself. A draft is blocked
# until the monitored system's address is known (learned from traffic, or typed in Settings).
# The reply contact, signature and wording are typed in Settings, never here.
# ABUSE_REPORTS_ENABLED=false
# Seconds between two draft builds (60 to 86400).
# ABUSE_BUILD_INTERVAL_S=3600
# A source is selected with this many failed logins, or a login followed by commands, a download
# attempt, or one of the severe tags (default: malware-drop, mirai, crypto-miner, php2shell,
# exploit and any cve-* tag).
# ABUSE_MIN_LOGIN_ATTEMPTS=50
# ABUSE_SEVERE_TAGS=malware-drop,mirai,crypto-miner,php2shell,exploit
# Days of evidence, minutes a source must be quiet before it is drafted, days before the same
# source can be reported again to the same recipient.
# ABUSE_LOOKBACK_DAYS=7
# ABUSE_SETTLE_MIN=30
# ABUSE_RESEND_DAYS=14
# Caps: subjects per report (max 100) and drafts open at once.
# ABUSE_MAX_SUBJECTS=100

# The SuckerPot network (M29, M33): an anonymous pool of what many honeypots see. It is unlocked
# by default, but nothing is sent until this system has joined: the installer asks (default yes,
# `--no-network` declines), and the dashboard can join or leave at any time (password again, five
# consents). An upgrade never joins an install that did not answer. It shares only daily
# aggregates: attacker addresses, rounded counts, blinded download links, malware hashes and
# command servers; never credentials, commands, ports, exact times or anything of yours. In full
# mode all traffic goes through the VPN egress gate. Leaving deletes your data at the hub and is
# final: a restart never joins again. Set false to switch the whole feature off.
# NETWORK_ENABLED=true
# Written by the installer and `just update`: marks that the network default was decided for this
# install (an older install without NETWORK_ENABLED is pinned to false once). Leave it alone.
# NETWORK_DEFAULT_PINNED=1
# NETWORK_HUB_URL=https://hub.example.org
# NETWORK_HUB_KEY=
# Seconds between worker cycles (30 to 86400).
# NETWORK_INTERVAL_S=900
# A finished UTC day is sent after a random wait between these hours (0 to 23).
# NETWORK_SUBMIT_DELAY_MIN_H=2
# NETWORK_SUBMIT_DELAY_MAX_H=20
# NETWORK_MAX_SOURCES=5000

# The public community blocklist feed (M30): signed lists of malware hosts and attack sources
# confirmed by many sensors. Free for anyone, whether or not you join the network above, and
# independent of it. Off by default. When on, ingest downloads the lists through the VPN egress
# gate only, checks the minisign signature against NETWORK_FEED_KEY and keeps the last good copy
# when a check fails. The download sends nothing that identifies you (generic client name, no
# cookie, no node id). Firewalls can also fetch the public URLs directly, without this switch.
# NETWORK_FEED_ENABLED=false
# NETWORK_FEED_URL=https://feeds.example.org/v1
# The feed's public key (starts with RW). Both are empty until the project publishes a feed.
# NETWORK_FEED_KEY=
# Seconds between fetches (900 to 86400).
# NETWORK_FEED_INTERVAL_S=3600
# Lists stored (inbound, inbound-high, outbound, outbound-high, outbound-domains).
# NETWORK_FEED_LISTS=inbound,outbound,outbound-domains
# ABUSE_MAX_OPEN_DRAFTS=200
# Hard RDAP request quotas (each redirect and fallback counts).
# ABUSE_RDAP_DAILY_QUOTA=1000
# ABUSE_RDAP_HOURLY_QUOTA=200
# Build drafts from demo data too (documentation addresses). Demo drafts can never be sent.
# ABUSE_REPORTS_INCLUDE_DEMO=false
# Times in reports are rounded to the minute. Set false to allow exact times.
# ABUSE_ROUND_TIMES=true
# Days to keep reports marked sent or closed (the duplicate check needs the history).
# ABUSE_REPORT_RETENTION_DAYS=730

# Replies to reports (M26). Off by default. The mailbox (host, user, password) is saved in
# Settings > Reporting, never here; it is read through the VPN only, and mail is never deleted.
# ABUSE_REPLIES_ENABLED=false
# Largest mail read, in bytes (65536 to 1048576), and limits per poll and per UTC day.
# ABUSE_REPLY_MAX_BYTES=262144
# ABUSE_REPLY_MAX_PER_POLL=50
# ABUSE_REPLY_DAILY_CAP=500
# Seconds one poll may take in total.
# ABUSE_REPLY_POLL_DEADLINE_S=120
# Characters of a reply kept as an excerpt (0 keeps none), and how many days it is kept.
# ABUSE_REPLY_EXCERPT_CHARS=2000
# ABUSE_REPLY_EXCERPT_DAYS=180
# A reply is matched to reports sent in the last N days.
# ABUSE_REPLY_MATCH_DAYS=120
# Days without any answer before a sent report is shown as "no answer" (1 to 365).
# ABUSE_NO_ANSWER_DAYS=14

# ---------------------------------------------------------------------------
# Takedown tracking and abuse.ch submission (M27). Everything is off by default.
# ---------------------------------------------------------------------------
# Track what happens to reported targets: is the payload URL still up, how long did it take to go
# down, which providers act. The collector re-checks only URLs that already served a malware
# sample to it (one bounded GET each, through the VPN, also needs COLLECTOR_ENABLED=true).
# C2 servers and attacking addresses are never contacted.
# TAKEDOWN_ENABLED=false
# Days a target is followed after it was reported (7 to 90).
# TAKEDOWN_TRACK_DAYS=30
# Daily caps: HTTP re-checks (collector), URLhaus/ThreatFox lookups and AbuseIPDB reads (ingest).
# TAKEDOWN_HTTP_DAILY_QUOTA=200
# TAKEDOWN_INTEL_DAILY_QUOTA=100
# TAKEDOWN_ABUSEIPDB_DAILY_QUOTA=50
# Days without a sighting before an attacking address counts as quiet.
# TAKEDOWN_QUIET_DAYS=7
# Seconds between two takedown cycles in ingest (30 to 86400).
# TAKEDOWN_INTERVAL_S=600
# Days to keep individual checks (the monthly roll-up is kept forever).
# TAKEDOWN_CHECK_RETENTION_DAYS=400
# Server-side switch for submitting captured malware URLs to URLhaus (and C2 addresses to
# ThreatFox). Off by default. Even when true nothing is sent until you pick a mode and add a
# dedicated abuse.ch Auth-Key in Settings. Use an abuse.ch account whose public name does not
# identify you. The key is not an environment variable.
# ABUSECH_SUBMIT_ENABLED=false

# ---------------------------------------------------------------------------
# Fake service identity
# ---------------------------------------------------------------------------

# Hostname that the fake SSH service shows to clients.
SSH_HOSTNAME=srv-web01

# SSH banner that the fake SSH service sends to clients.
SSH_BANNER="SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13.14"

# Comma-separated user:password pairs that the fake SSH server accepts.
# Keep them weak on purpose: attackers must be able to "log in" to be observed.
SSH_ACCEPT_CREDENTIALS=root:root,root:123456,root:password,admin:admin,ubuntu:ubuntu,pi:raspberry,user:user

# Probability (0.0 to 1.0) of accepting any non-empty password.
SSH_ACCEPT_RANDOM_PROB=0.0

# Failed attempts allowed per connection before it is closed.
SSH_MAX_AUTH_ATTEMPTS=6

# Maximum simultaneous SSH connections, in total and per source IP.
SSH_MAX_CONNECTIONS=200
SSH_MAX_PER_IP=5

# Optional: fixed NetBIOS name (1 to 15 characters) shown by the RDP sensor's certificate.
# By default a realistic name is derived and kept in the rdp-data volume.
# RDP_HOSTNAME=

# Publisher backstop for every sensor: maximum serialized event bytes per second
# and burst. Protects Redis and ingest from a single flooding source.
# EVENTS_MAX_BYTES_PER_SEC=200000
# EVENTS_MAX_BYTES_BURST=2000000

# ---------------------------------------------------------------------------
# SSH sensor tuning (optional). Defaults shown; uncomment to change.
# ---------------------------------------------------------------------------

# Largest SSH channel window, in KiB (limits data buffered per channel).
# SSH_CHANNEL_WINDOW_KB=32

# Inbound traffic caps, in KiB per second: per connection and for the whole sensor.
# SSH_INBOUND_CONN_KB_PER_SEC=32
# SSH_INBOUND_KB_PER_SEC=256

# Fake-shell CPU budget: share of one CPU all sessions may use, and burst (seconds).
# SSH_SHELL_CPU_SHARE=0.3
# SSH_SHELL_CPU_BURST=0.2

# Memory protection. The limit is set to the container's mem_limit in compose
# (SSH_MEMORY_LIMIT_MB=256 there). The sensor sheds load at "pressure" and
# refuses new work at "critical" (fractions of the limit); one source IP may hold
# at most "share per ip" of the budget.
# SSH_MEMORY_PRESSURE=0.70
# SSH_MEMORY_CRITICAL=0.85
# SSH_MEMORY_SHARE_PER_IP=0.25
# SSH_MEMORY_BUDGET_MB=48

# Event size caps (bytes per second and burst), per source IP and for the sensor.
# SSH_IP_EVENT_BYTES_PER_SEC=20000
# SSH_IP_EVENT_BYTES_BURST=1000000
# SSH_GLOBAL_EVENT_BYTES_PER_SEC=200000
# SSH_GLOBAL_EVENT_BYTES_BURST=2000000

# Seconds between the sensor's statistics log line and its per-IP summary events.
# SSH_STATS_INTERVAL=60
# SSH_SUMMARY_INTERVAL=60

# ---------------------------------------------------------------------------
# Web sensor tuning (optional). Defaults shown; uncomment to change.
# ---------------------------------------------------------------------------

# Host name shown in the certificate and in phpinfo.
# WEB_HOSTNAME=srv-web01

# Fake software versions. PHP must be 8.3.N with N below 36 (an unpatched version).
# WEB_PHP_VERSION=8.3.6
# WEB_WP_VERSION=6.8.1

# Connection caps: in total and per source IP.
# WEB_MAX_CONNECTIONS=200
# WEB_MAX_PER_IP=10

# Streams that ingest reads, comma-separated. Leave unset: the default covers every built-in
# sensor, and an override must list each one (ingest logs a warning when one is missing).
# INGEST_STREAMS=events:ssh,events:telnet,events:web,events:rdp,events:redis,events:docker,events:mysql,events:mssql,events:adb,events:smb,events:sip,events:synology

# ---------------------------------------------------------------------------
# M1 additions: ingest, dashboard bind address and demo data
# ---------------------------------------------------------------------------

# Password for the health ACL user. It can only run PING (used by the Redis healthcheck).
REDIS_HEALTH_PASSWORD=change-me

# Password for the ingest ACL user. Allowed to read and acknowledge the events
# stream only. Use a long random value.
REDIS_INGEST_PASSWORD=change-me

# Address the dashboard port is bound to on the host. 127.0.0.1 keeps it local.
# Set it to the host's LAN address only when a reverse tunnel on another machine
# must reach it. The port must then be filtered upstream (hypervisor or router
# firewall, or the DOCKER-USER chain), because published Docker ports bypass
# ordinary host INPUT rules.
DASHBOARD_BIND=127.0.0.1

# Safety switch: Redis and migrations refuse secrets that are shorter than 24
# characters or reused between accounts. Set this to 1 ONLY in CI or throwaway tests.
# SUCKERPOT_ALLOW_DEFAULT_SECRETS=0

# Approximate maximum length of the Redis events stream (XADD MAXLEN ~).
EVENTS_MAXLEN=10000

# Demo data generator (just demo): how many days to cover, how many sessions
# to create, and the random seed (same seed, same data).
DEMO_DAYS=30
DEMO_SESSIONS=3000
DEMO_SEED=42

# Stream length cap used by the demo generator only. Keep it above the number of
# events per sensor in a backfill, or entries ingest has not read yet get trimmed.
DEMO_EVENTS_MAXLEN=100000

# ---------------------------------------------------------------------------
# Database, service and VoIP sensors (optional). Defaults shown; uncomment to change.
# ---------------------------------------------------------------------------

# Stream length cap (XADD MAXLEN ~) for the Redis, Docker, MySQL, MSSQL, ADB, SMB, SIP and
# Synology sensors. Kept short so a burst on eight more streams cannot fill Redis memory; ingest
# drains the streams continuously, and a sensor drops (never buffers) events when XADD fails.
# EVENTS_MAXLEN_LOW=3000

# Connection caps per sensor: in total and per source IP.
# REDIS_MAX_CONNECTIONS=200
# REDIS_MAX_PER_IP=8
# DOCKER_MAX_CONNECTIONS=200
# DOCKER_MAX_PER_IP=8
# MYSQL_MAX_CONNECTIONS=200
# MYSQL_MAX_PER_IP=8
# MSSQL_MAX_CONNECTIONS=200
# MSSQL_MAX_PER_IP=8

# RDP: "required" (default) only accepts NLA clients and records NTLM logins; "optional" also
# accepts TLS-only clients and records the cleartext password they send in the Client Info PDU.
# RDP_NLA_MODE=required
# Decoy accounts whose NTLM responses are checked (user:password, comma separated). Only these
# pairs are ever verified; nothing else is cracked.
# RDP_ACCOUNTS=administrator:P@ssw0rd,administrator:123456,admin:admin

# ADB_MAX_CONNECTIONS=200
# ADB_MAX_PER_IP=8
# SMB_MAX_CONNECTIONS=200
# SMB_MAX_PER_IP=10
# SIP_MAX_CONNECTIONS=200
# SIP_MAX_PER_IP=8
# SYNOLOGY_MAX_CONNECTIONS=200
# SYNOLOGY_MAX_PER_IP=8
# Synology sensor: new connections per second per source IP (sustained rate and burst).
# SYNOLOGY_CONN_RATE=5
# SYNOLOGY_CONN_BURST=20
# Synology sensor: megabytes of connections and request bodies held at once, and the
# events per second it may emit per source IP and in total.
# SYNOLOGY_MEMORY_BUDGET_MB=80
# SYNOLOGY_EVENTS_PER_SEC=20
# SYNOLOGY_GLOBAL_EVENTS_PER_SEC=200
# Synology sensor: redirect the HTTP login page to HTTPS, like a real DSM.
# SYNOLOGY_HTTP_REDIRECT=false

# MySQL sensor: accounts that "work", as user:password pairs (empty password after the colon).
# MYSQL_ACCOUNTS=root:,root:root,admin:admin,mysql:mysql

# SMB sensor: optional NetBIOS host name (1 to 15 characters) and domain. By default
# realistic names are derived and kept in the smb-sensor-data volume.
# SMB_HOSTNAME=
# SMB_DOMAIN=
# How to treat an SMBv1 negotiation: "steer" (default, answer with SMB2) or "reset".
# SMB_SMB1_MODE=steer

# SIP sensor: public IP addresses of this honeypot, comma-separated. The sensor never
# answers them, so it cannot be turned into a reflector aimed at itself. Leave empty
# if unknown; replies are rate limited and never larger than the request anyway.
# SIP_OWN_IPS=

# ---------------------------------------------------------------------------
# Participant mode (written by `scripts/install.sh --participant`; full installs leave these unset)
# ---------------------------------------------------------------------------
# Participant mode runs sensors, database, ingest and the network node, without the dashboard.
# Every line below is commented on purpose: the installer fills them in, and a full install must
# not carry them. See docs/design/m32.md section 4.1 for the values per mode.

# "full" (the default when absent) or "participant".
# SUCKERPOT_STACK_MODE=full
# Participant overlay, joined to COMPOSE_FILE by the installer.
# COMPOSE_FILE=docker-compose.yml:docker-compose.participant.yml
# Profile "direct" starts hubproxy (no VPN); profile "egress" starts the VPN.
# COMPOSE_PROFILES=direct
# "direct" reaches only the hub through hubproxy; "vpn" (the default) uses the VPN proxy.
# EGRESS_MODE=vpn
# Names the hubproxy may connect to, as host:443 pairs (comma-separated). Direct mode only.
# HUBPROXY_ALLOW=hub.example.org:443

# Consent record written by the installer (participant mode, or the full-mode network question)
# or `scripts/participant.sh join` (never by `just set`). Ingest joins from it once.
# NETWORK_CONSENT=v2:sources,payloads,c2,files,rechecks,verify_reveals:2026-01-01
# Optional pseudonym, country (two letters) and whether the country is shown.
# NETWORK_PSEUDONYM=
# NETWORK_COUNTRY=
# NETWORK_SHOW_COUNTRY=false
# Answer verification requests for links that several sensors saw (participant default: true).
# NETWORK_VERIFY_REVEALS=false
# Ask to be a verifier (needs a VPN and the collector; the hub operator must grant the role).
# NETWORK_VERIFIER=false
# COLLECTOR_VERIFY_ENABLED=false
# Local daily caps on verification work.
# NETWORK_VERIFY_DAILY_CAP=100
# NETWORK_VERIFY_HOST_DAILY_CAP=3
# Learned own addresses act without a click (participant mode: true).
# SELF_TERMS_AUTO_CONFIRM=false
# Optional own public address. Never looked up by any script.
# SELF_ADDRESS=

# Install new signed releases by itself once a day (a cron line of the installing user, see
# scripts/participant.sh auto-update). Participant installs: true. Full installs: false.
# AUTO_UPDATE_ENABLED=false
