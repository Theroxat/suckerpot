# Edge of the hub. Nothing about a client is logged: no access log, and the default logger
# writes nowhere (client addresses show up in TLS error lines otherwise).
{
	admin off
	log {
		output discard
	}
	servers {
		protocols h1 h2
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 20s
			write 30s
			idle 2m
		}
	}
}

{$HUB_DOMAIN} {
	log {
		output discard
	}
	request_body {
		max_size 1MiB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
		-Server
	}
	handle /v1/* {
		# Caddy replaces any client-supplied forwarding header with the real peer address.
		reverse_proxy hub-api:8080
	}
	handle {
		respond "Not Found" 404
	}
}

# The public feed site: static files only, the same for everyone. No access log, no cookies, no
# CDN, no query handling. The feeds volume is mounted read-only. Design M30 sections 6.1 and 8.
{$HUB_FEEDS_DOMAIN} {
	log {
		output discard
	}
	request_body {
		max_size 64KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cache-Control "public, max-age=900"
		-Server
	}

	# Delisting and lookup are the only dynamic paths; hub-api answers them.
	@api path /v1/delist /v1/delist/* /v1/lookup
	handle @api {
		@apibad not method GET HEAD POST
		respond @apibad "Method Not Allowed" 405
		header Cache-Control "no-store"
		reverse_proxy hub-api:8080
	}

	handle /v1/* {
		@readonly not method GET HEAD
		respond @readonly "Method Not Allowed" 405

		# Never serve temporary publication directories or any dot file.
		@hidden path /v1/.* /v1/*/.*
		respond @hidden "Not Found" 404

		@plain path *.txt *.nft *.ipset *.rsc *.minisig
		header @plain Content-Type "text/plain; charset=utf-8"
		# The delisting page: inline script and style pinned by hash (tests/test_feeds_privacy.py
		# recomputes both from static/delist.html), nothing else may load or run.
		@page path /v1/delist.html
		header @page Content-Security-Policy "default-src 'none'; script-src 'sha256-Zp2mLyxOAn1EMFrIZjQnA9PcHojINbKic2Hjw1GrkSY='; style-src 'sha256-vTVC0cS3214e7DOUbc/X6p6MV78OWzfhcKo5DhngLhY='; connect-src 'self'; worker-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		@project path /v1/stats.json /v1/index.json
		header @project Access-Control-Allow-Origin "*"
		# The public observatory (design M34): one browser origin, read only.
		@observatory path /v1/network.json /v1/network.json.gz
		header @observatory {
			Access-Control-Allow-Origin "{$HUB_OBSERVATORY_ORIGIN:https://suckerpot.selfhostr.io}"
			Access-Control-Allow-Methods "GET"
		}

		# The feed index names files in lower case (a format rule); README.txt is its public name.
		@readme path /v1/README.txt /v1/README.txt.minisig /v1/README.txt.gz
		uri @readme replace README.txt readme.txt

		uri strip_prefix /v1
		root * /srv/feeds
		file_server {
			precompressed gzip
			index off
			hide .tmp-* .*
		}
	}

	handle {
		respond "Not Found" 404
	}
}
