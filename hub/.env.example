# SuckerPot hub: placeholders only. Copy to .env on the hub machine and fill in.
# This is NOT the node's .env. The hub is deployed separately, never on a member's connection.

# Public name of the hub (DNS must point at the machine; Caddy gets the certificate itself).
HUB_DOMAIN=hub.example.org

# Public name of the feed site (a separate host name, same machine; Caddy gets its certificate).
HUB_FEEDS_DOMAIN=feeds.example.org

# Prefix of the external volumes (<prefix>_db-data, <prefix>_backups, <prefix>_feeds). Create them first.
HUB_VOLUME_PREFIX=hubprod

# Database passwords: 24+ characters, letters, digits, - and _, all different.
HUB_DB_PASSWORD=
HUB_API_DB_PASSWORD=
HUB_WORKER_DB_PASSWORD=

# Host path of the hub signing key (a file holding the base64url seed).
# Make it once, before the first start:
#   mkdir -p secrets && sudo chown 10001 secrets && sudo chmod 700 secrets
#   docker compose run --rm hub-admin gen-signing-key --out /keys/hub_signing_key
# and publish the printed public key as NETWORK_HUB_KEY in the node documentation.
HUB_SIGNING_KEY_PATH=./secrets/hub_signing_key

# Enrolment and consensus (defaults shown).
HUB_POW_DIFFICULTY=27
HUB_ENROL_SOFT_CAP=3
HUB_ENROL_HARD_CAP=5000
HUB_ENROL_STEP=3
HUB_CHALLENGES_PER_PREFIX=20
HUB_NODE_MIN_AGE_DAYS=14
HUB_NODE_MIN_ACTIVE_DAYS=7
HUB_MIN_NODES=5
HUB_MIN_WEIGHT=3.0
HUB_MIN_REPUTATION=0.3
HUB_WINDOW_DAYS=7
HUB_COHORT_MAX_SHARE=0.5
HUB_OBS_RETENTION_DAYS=14
# Reports sent without review need this many independent enrolment cohorts.
HUB_AUTO_MIN_COHORTS=5
# Seconds between worker runs.
HUB_WORKER_INTERVAL_S=3600

# Rate limits (defaults shown).
HUB_RATE_UNSIGNED_PER_MIN=10
HUB_RATE_UNSIGNED_PER_DAY=100
HUB_RATE_SIGNED_PER_HOUR=60
HUB_REVEALS_PER_DAY=2000
HUB_NEW_VALUES_PER_DAY=20000

# Reports: review (an operator approves each one), auto (sent after the hold) or off.
HUB_REPORT_MODE=review
HUB_REPORT_HOLD_HOURS=24
HUB_REPORT_DAILY_CAP=100
# Report wording lives on the hub machine, not in the repository. Empty = facts only.
HUB_REPORT_TEMPLATE_FILE=
HUB_REPORT_REPLY_TO=

# Project mailbox used to send reports (SMTP over TLS).
HUB_SMTP_HOST=
HUB_SMTP_PORT=587
HUB_SMTP_USER=
HUB_SMTP_PASSWORD=
HUB_SMTP_FROM=
HUB_SMTP_STARTTLS=true

# abuse.ch submissions: confirmed malware download URLs go to URLhaus, command-and-control
# endpoints to ThreatFox. off = nothing is queued or sent; review = an operator approves each
# submission; auto = URLhaus submissions are sent after the report hold (ThreatFox never is).
# Needs an abuse.ch Auth-Key (free account). Empty key = off, whatever the mode.
HUB_ABUSECH_MODE=off
HUB_ABUSECH_AUTH_KEY=
HUB_ABUSECH_DAILY_CAP=50

# Optional corroboration sources for single-signal addresses (empty = off).
HUB_ABUSEIPDB_KEY=
HUB_GREYNOISE_KEY=

# Public blocklist feeds (defaults shown). off = nothing is read, fetched or written;
# review = an operator releases every change that adds values; auto = published after the hold.
HUB_FEED_MODE=off
HUB_FEED_DIR=/srv/feeds
# Host path of the minisign feed key, and where the containers see it (a different key from the
# hub signing key). Make it once (create the file first, as hub/README.md shows):
#   docker compose run --rm hub-admin gen-feed-key --out /keys/feed_key --force
HUB_FEED_KEY_PATH=./secrets/feed_key
HUB_FEED_SIGNING_KEY_FILE=/run/secrets/hub_feed_key
# Minutes between runs, hours a value waits before it is listed, days a signed index stays valid.
HUB_FEED_INTERVAL_MIN=60
HUB_FEED_HOLD_HOURS=6
HUB_FEED_VALID_DAYS=3
# Days without a new sighting before a value leaves the list.
HUB_FEED_TTL_INBOUND_DAYS=7
HUB_FEED_TTL_PAYLOAD_DAYS=14
HUB_FEED_TTL_C2_DAYS=30
# Size caps per list.
HUB_FEED_MAX_INBOUND=50000
HUB_FEED_MAX_OUTBOUND=20000
HUB_FEED_MAX_DOMAINS=20000
# Change breaker: a run that adds or removes more than this share (and at least MIN values) waits
# for an operator.
HUB_FEED_BREAKER_ADD_PCT=50
HUB_FEED_BREAKER_REMOVE_PCT=50
HUB_FEED_BREAKER_MIN=200
# Extra addresses or names that no feed may carry (the hub's own, comma separated).
HUB_FEED_NEVER=
# Fetch the CDN and Tor range lists that feed the exclusions. With false the feeds stay off.
HUB_EXTERNAL_RANGES_ENABLED=true

# Public delisting: proof-of-work bits for a request, requests accepted per day, and how many
# inbound values may be hidden per day before an operator has looked at them.
HUB_DELIST_POW_DIFFICULTY=20
HUB_DELIST_DAILY_CAP=200
HUB_DELIST_AUTO_SUPPRESS_DAILY=50
# Mailbox named in the public README.txt for delisting by e-mail (empty = the form only).
HUB_DELIST_MAILBOX=

# Public network observatory: network.json on the feed site, rebuilt once a day with anonymised
# network figures (design M34). Independent of HUB_FEED_MODE: the lists can stay off.
HUB_OBSERVATORY_ENABLED=false
# The one browser origin allowed to fetch network.json (CORS, GET only).
HUB_OBSERVATORY_ORIGIN=https://suckerpot.selfhostr.io

# --- "Behind a tunnel" mode (docker-compose.tunnel.yml; see README "Behind a tunnel") ---
# Host address and port Caddy listens on for the tunnel connector (plain HTTP). Use a private
# address, never 0.0.0.0 on a public interface.
#HUB_BIND=192.0.2.10
#HUB_HTTP_PORT=8088
# Who may name the client address (required in tunnel mode): the address of the tunnel connector
# when it runs on another machine. Only if it runs on the hub host (or arrives through Docker's
# userland proxy) use the gateway of hub-public (first address of HUB_PUBLIC_SUBNET). Several
# space-separated addresses or ranges are allowed. Never a broad private range.
#HUB_TRUSTED_PROXY=192.0.2.20
#HUB_PUBLIC_SUBNET=198.18.77.0/24
# Existing Docker network of the proxy, and the authenticated HTTP proxy on it.
#HUB_EGRESS_NETWORK=vpn_egress
#HUB_EGRESS_PROXY=http://user:change-me@vpn:8888
# The egress network must be `internal: true` with the proxy as its only uplink; the worker
# refuses to start when a proxy is set and it still has a default route.

# --- Link verification (M32). Off by default: no task is created and no early reveal accepted. ---
# review: an operator approves each link before any verifier gets it (the default once enabled).
# auto: tasks are released after a random delay without review.
HUB_VERIFY_MODE=off
# Eligible nodes that must have reported a link (never below 2: the hub refuses to start).
HUB_VERIFY_MIN_REPORTERS=2
# Tasks per day for the whole network, and per site per day.
HUB_VERIFY_DAILY_CAP=200
HUB_VERIFY_HOST_DAILY_CAP=5
# How long a verifier holds a task, and how many tries a link gets.
HUB_VERIFY_LEASE_HOURS=6
HUB_VERIFY_MAX_ATTEMPTS=2
# Only links reported in the last N days are considered.
HUB_VERIFY_URL_MAX_AGE_DAYS=3
# Random delay between the reveal and the release of a task in auto mode (hours).
HUB_VERIFY_DELAY_MIN_H=6
HUB_VERIFY_DELAY_MAX_H=30
# Alternate hub signing key for a key rollover (answers carry both signatures). Empty = none.
HUB_SIGNING_KEY_ALT_FILE=
