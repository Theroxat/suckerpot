# Public defaults of the Selfhostr network. Shipped with each release; do not edit.
# An explicit value in .env always wins.
NETWORK_DEFAULTS_VERSION=1
NETWORK_HUB_URL=https://hub.selfhostr.io
NETWORK_HUB_KEY=<HUB_PUBLIC_KEY>
NETWORK_FEED_URL=https://feeds.selfhostr.io/v1
NETWORK_FEED_KEY=<FEED_PUBLIC_KEY>
